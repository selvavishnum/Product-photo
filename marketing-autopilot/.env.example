# --- core ---
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autopilot
REDIS_URL=redis://localhost:6379

# --- LLM (pick one; Gemini is the default) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- token encryption ---
# 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Ad-account OAuth tokens are encrypted with this before they touch the DB.
# Losing it means every connected account must reconnect.
TOKEN_ENCRYPTION_KEY=

# --- ad platforms (see README: both need approval before live spend) ---
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# --- spend safety ---
# Hard ceiling enforced server-side, independent of anything a client sends.
MAX_DAILY_BUDGET_INR=5000

# --- object storage for generated banners (S3-compatible) ---
# Cloudflare R2 is the cheap default: no egress fees, and ad platforms fetch
# these images repeatedly. Leave S3_ENDPOINT unset for real AWS S3.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
